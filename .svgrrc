{
  "replaceAttrValues": {
    "#8B5CF6": "{props.fill}",
    "#8b5cf6": "{props.fill}"
  },
  "svgoConfig": {
    "plugins": [
      {
        "name": "preset-default",
        "params": {
          "overrides": {
            "inlineStyles": {
              "onlyMatchedOnce": false
            },
            "removeViewBox": false,
            "removeUnknownsAndDefaults": false,
            "convertColors": false
          }
        }
      },
      "convertStyleToAttrs"
    ]
  }
}
